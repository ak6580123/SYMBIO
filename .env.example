# ---------------------------------------------------------------------------
# Symbio — sample environment configuration
#
# Copy to .env (backend) and frontend/.env.local, then adjust if needed.
# Nothing here is a secret: Symbio uses no paid APIs and no keys.
# ---------------------------------------------------------------------------

# --- Backend (FastAPI) ------------------------------------------------------

# Local Ollama server. Install from https://ollama.com and run `ollama serve`.
OLLAMA_URL=http://localhost:11434

# Model used for material identification. Pull it once with:
#   ollama pull qwen2.5:3b
OLLAMA_MODEL=qwen2.5:3b

# How long to wait for the model before falling back to the deterministic
# classifier. Raise this on slower machines; qwen2.5:3b on CPU can take 10-30s.
OLLAMA_TIMEOUT_SECONDS=60

# Cheap reachability check before we commit to a full inference call. If Ollama
# is listening but wedged (still loading a model, or busy with another request),
# this is how long we wait before falling back instead of blocking.
OLLAMA_PROBE_TIMEOUT_SECONDS=2

# Port the API listens on.
PORT=8000

# --- Frontend (Next.js) -----------------------------------------------------
# Put this in frontend/.env.local

# Where the Next.js server proxies /api/* to. Read server-side only, so it is
# never exposed to the browser and needs no CORS configuration.
BACKEND_URL=http://localhost:8000

# How long the Next dev server will wait for the backend before aborting the
# proxied request. Next.js defaults to 30s, which is shorter than
# OLLAMA_TIMEOUT_SECONDS - if analysis fails with a 500 after ~30s, this is why.
# Keep it comfortably above OLLAMA_TIMEOUT_SECONDS.
PROXY_TIMEOUT_MS=120000

# ---------------------------------------------------------------------------
# Optional: Supabase / PostgreSQL
#
# The MVP does not need a database — analyses live in process memory and the
# material/recipient knowledge base is seeded JSON. To move to Supabase later,
# re-implement backend/services/storage.py and backend/knowledge_base/loader.py
# against a Postgres client; nothing else imports those files' internals.
#
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# DATABASE_URL=
# ---------------------------------------------------------------------------
