# ---------------------------------------------------------------------------
# Symbio — sample environment configuration
#
# Copy to .env (backend) and frontend/.env.local, then adjust if needed.
# Nothing here is a secret: Symbio uses no paid APIs and no keys.
# ---------------------------------------------------------------------------

# --- Backend (FastAPI) ------------------------------------------------------

# Local Ollama server. Install from https://ollama.com and run `ollama serve`.
OLLAMA_URL=http://localhost:11434

# Set to false to force the deterministic keyword classifier even when Ollama is
# installed and running - useful for a fast, reproducible demo or test run.
# OLLAMA_ENABLED=false

# Model used for material identification. Pull it once with:
#   ollama pull qwen2.5:3b
# This is the preferred model, not a requirement: if it is not installed, Symbio
# drives whatever chat model you already have pulled and says so in the UI.
# Setting the variable at all pins the choice - it is then used if present and
# never substituted - so it is deliberately left commented out here even though
# qwen2.5:3b is the default. Uncomment only if you want to forbid substitution.
# OLLAMA_MODEL=qwen2.5:3b

# How long to wait for the model before falling back to the deterministic
# classifier. Raise this on slower machines; qwen2.5:3b on CPU can take 10-30s.
OLLAMA_TIMEOUT_SECONDS=60

# Cheap reachability check before we commit to a full inference call. If Ollama
# is listening but wedged (still loading a model, or busy with another request),
# this is how long we wait before falling back instead of blocking.
OLLAMA_PROBE_TIMEOUT_SECONDS=2

# Port the API listens on.
PORT=8000

# --- Frontend (Next.js) -----------------------------------------------------
# Put this in frontend/.env.local

# Where the Next.js server proxies /api/* to. Read server-side only, so it is
# never exposed to the browser and needs no CORS configuration.
BACKEND_URL=http://localhost:8000

# How long the Next dev server will wait for the backend before aborting the
# proxied request. Next.js defaults to 30s, which is shorter than
# OLLAMA_TIMEOUT_SECONDS - if analysis fails with a 500 after ~30s, this is why.
# Keep it comfortably above OLLAMA_TIMEOUT_SECONDS.
PROXY_TIMEOUT_MS=120000

# Basemap tiles for the map. Optional - leave unset and the map uses the
# OpenStreetMap raster endpoint, which needs no key and no account.
#
# Set this if tile.openstreetmap.org refuses your network. It answers HTTP 403
# ("not following the tile usage policy") to traffic it cannot attribute to an
# app, which includes most cloud/preview egress IPs and some campus networks.
# The example below is a public OpenStreetMap-data endpoint; the map page also
# offers it as a one-click fallback when tiles are refused.
# NEXT_PUBLIC_TILE_URL=https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png
# NEXT_PUBLIC_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors &copy; CARTO

# ---------------------------------------------------------------------------
# Persistent data: PostgreSQL (or the local development file)
#
# Three kinds of data live in Symbio and they behave differently. The seeded network
# (40 recipients, 15 sources, 19 listings) ships as JSON with the code and is read-only.
# An organisation's own records - accounts, profile, facilities, published listings,
# saved analyses - go to the database below. Anything typed without an account stays in
# the running process and disappears with it.
#
# No secret is required to start the app. With DATABASE_URL unset, Symbio writes to a
# local SQLite file so sign-in, listings and history work on a laptop; set the URL (a
# Postgres instance, Supabase included - it is a Postgres connection string) and the same
# code paths run against Postgres instead.
#
# SUPABASE note: Symbio uses its own accounts and Argon2id password hashes in this
# database. It does not call Supabase Auth, so nothing here needs a service-role key.
# ---------------------------------------------------------------------------

# DATABASE_URL=postgresql://user:password@host:5432/dbname

# auto (default) | postgres | sqlite | off
#   postgres - require DATABASE_URL and refuse to start without it
#   sqlite   - use the local file even when a URL is present
#   off      - no persistence at all: the public demo works, accounts do not
# SYMBIO_DB_MODE=auto

# Where the development database file goes. Defaults to
# ${HOME}/.local/share/symbio/symbio.db.
# SYMBIO_SQLITE_PATH=/home/you/.local/share/symbio/symbio.db

# Apply pending migrations at startup. Off means a screen reports that the schema needs
# `python -m db.migrate apply` rather than changing tables underneath a running service.
SYMBIO_MIGRATE_ON_START=1
# SYMBIO_MIGRATIONS_DIR=backend/db/migrations
# SYMBIO_DATA_DIR=

# --- Geography: the one external provider -----------------------------------
# Geocoding and routing come from OpenStreetMap services: Nominatim for places, the
# public OSRM demo for roads. Neither needs a key; both ask that a request identifies the
# application, so set GEO_CONTACT to a page or mail address a provider can write to.
# Where a provider refuses, times out or has nothing to say, Symbio keeps the location as
# typed and reports the distance as unavailable - it does not guess a place.
GEO_CONTACT=https://example.org/symbio-contact
# GEOCODING_PROVIDER=nominatim        # or `off`
# ROUTING_PROVIDER=osrm               # `osrm`, `ors`, or `off`
# ORS_API_KEY=                        # only for ROUTING_PROVIDER=ors (OpenRouteService)
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# OSRM_BASE_URL=https://router.project-osrm.org
# ORS_BASE_URL=https://api.openrouteservice.org
GEO_MIN_INTERVAL_MS=1100
ROUTE_MIN_INTERVAL_MS=250
GEO_TIMEOUT_SECONDS=4
GEO_CACHE_HOURS=720
GEO_FAILURE_COOLDOWN_SECONDS=60
# Bias ambiguous place names toward one country's border; empty means no bias.
GEO_COUNTRY_CODES=

# --- Security baseline ------------------------------------------------------
# Requests per minute per client, per bucket. `off` disables the limiter (tests only).
SYMBIO_RATE_LIMIT=on
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_WRITE_PER_MINUTE=60
RATE_LIMIT_READ_PER_MINUTE=600
# Set to 1 only when a reverse proxy in front of Symbio sets X-Forwarded-For.
TRUST_PROXY=0
# Used to decide whether session cookies carry `Secure`, and for the CSRF origin check.
APP_URL=http://localhost:3000
# Comma-separated origins allowed to call the API with credentials. Empty (the default)
# means no cross-origin request is permitted, which is correct when Next.js proxies /api.
CORS_ALLOW_ORIGINS=
# ALLOWED_ORIGINS=
